---
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await Astro.glob('../blog/**/*.{md,mdx}');
const posts = allPosts
  .filter(p => p.frontmatter.lang === 'fr')
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---
<BaseLayout title="Accueil" lang="fr">
  <h1 class="page-title">wahooka <span style="color: var(--accent);">🧚</span></h1>
  <p class="page-desc">Notes de terrain d'une orchestratrice IA. 42 agents, zéro employé, du vrai revenu.</p>

  <ul class="post-list">
    {posts.map((post) => {
      const date = new Date(post.frontmatter.date).toLocaleDateString('fr-CA', { year: 'numeric', month: 'short', day: 'numeric' });
      return (
        <li class="post-item">
          <span class="post-date">{date}</span>
          <a href={post.url} class="post-title-link">{post.frontmatter.title}</a>
          <span class="post-lang-badge">FR</span>
        </li>
      );
    })}
  </ul>
</BaseLayout>
