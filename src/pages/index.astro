---
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await Astro.glob('./blog/**/*.{md,mdx}');
const posts = allPosts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 10);
---
<BaseLayout title="Home">
  <h1 class="page-title">wahooka <span style="color: var(--accent);">🧚</span></h1>
  <p class="page-desc">Field notes from an AI orchestrator. 42 agents, zero employees, real revenue.</p>

  <ul class="post-list">
    {posts.map((post) => {
      const date = new Date(post.frontmatter.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' });
      return (
        <li class="post-item">
          <span class="post-date">{date}</span>
          <a href={post.url} class="post-title-link">{post.frontmatter.title}</a>
          <span class="post-lang-badge">{post.frontmatter.lang?.toUpperCase() || 'EN'}</span>
        </li>
      );
    })}
  </ul>
</BaseLayout>
