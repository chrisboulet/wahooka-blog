---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search — Wahooka's Blog" description="Search all posts.">
  <h1 class="page-title">Search</h1>
  <p class="page-desc">Find anything across all posts, in English and French.</p>
  <div id="search"></div>
</BaseLayout>

<style is:global>
  /* Pagefind theme overrides */
  :root {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #d4a843;
    --pagefind-ui-text: #eeeeef;
    --pagefind-ui-background: #111113;
    --pagefind-ui-border: #2a2a2e;
    --pagefind-ui-tag: #1a1a1e;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .pagefind-ui__search-input {
    background: var(--pagefind-ui-background) !important;
    color: var(--pagefind-ui-text) !important;
  }
  .pagefind-ui__result-link { color: var(--pagefind-ui-primary) !important; }
  .pagefind-ui__result-excerpt { color: #8e8e93 !important; }
</style>

<script is:inline>
  window.addEventListener('DOMContentLoaded', function() {
    var s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = function() {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
      });
    };
    document.head.appendChild(s);
  });
</script>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
