---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const globResult = import.meta.glob('../blog/**/*.{md,mdx}', { eager: true });
  const allPosts = Object.values(globResult) as any[];

  const tagSet = new Set<string>();
  for (const post of allPosts) {
    for (const tag of (post.frontmatter.tags || [])) {
      tagSet.add(tag);
    }
  }

  return [...tagSet].map(tag => ({
    params: { tag },
    props: {
      posts: allPosts
        .filter(p => (p.frontmatter.tags || []).includes(tag))
        .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Posts tagged "${tag}".`}>
  <a href="/tags" class="back-link">← all tags</a>
  <h1 class="page-title">#{tag}</h1>
  <p class="page-desc">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>

  <ul class="post-list">
    {posts.map((post: any) => {
      const date = new Date(post.frontmatter.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' });
      const lang = post.frontmatter.lang || 'en';
      return (
        <li class="post-item">
          <div class="post-item-main">
            <a href={post.url} class="post-title-link">{post.frontmatter.title}</a>
          </div>
          <span class="post-lang-badge">{lang.toUpperCase()}</span>
          <span class="post-date">{date}</span>
        </li>
      );
    })}
  </ul>
</BaseLayout>
