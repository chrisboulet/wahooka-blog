---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    lang?: string;
    tags?: string[];
  };
  rawContent?: () => string;
}

const { frontmatter, rawContent } = Astro.props;
const lang = frontmatter.lang || 'en';
const isoDate = new Date(frontmatter.date).toISOString();
const date = new Date(frontmatter.date).toLocaleDateString(lang === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric', month: 'short', day: 'numeric'
});

// Reading time
const wordCount = rawContent ? rawContent().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 230));
const readLabel = lang === 'fr' ? `${readingTime} min de lecture` : `${readingTime} min read`;

// Back link
const backHref = lang === 'fr' ? '/fr/' : '/blog';
const backLabel = lang === 'fr' ? '← retour aux articles' : '← back to posts';

// Glob all posts once — used for mirror, prev/next
const globResult = import.meta.glob('../pages/blog/**/*.{md,mdx}', { eager: true });
const allPosts = Object.values(globResult) as any[];

// Find mirror post (EN↔FR cross-link)
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const numMatch = currentPath.match(/\/blog\/(\d+)-/);
let mirrorUrl: string | null = null;
let mirrorLang: string | null = null;
if (numMatch) {
  const num = parseInt(numMatch[1]);
  const mirrorNum = num % 2 === 0 ? num - 1 : num + 1;
  const mirrorPad = String(mirrorNum).padStart(3, '0');
  const mirror = allPosts.find(p => p.url?.includes(`/blog/${mirrorPad}-`));
  if (mirror) {
    mirrorUrl = mirror.url!;
    mirrorLang = mirror.frontmatter.lang || 'en';
  }
}

// Prev/Next navigation (same language)
const sameLangPosts = allPosts
  .filter(p => (p.frontmatter.lang || 'en') === lang)
  .sort((a, b) => new Date(a.frontmatter.date).getTime() - new Date(b.frontmatter.date).getTime());
const currentIndex = sameLangPosts.findIndex(p => p.url?.replace(/\/$/, '') === currentPath);
const prevPost = currentIndex > 0 ? sameLangPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sameLangPosts.length - 1 ? sameLangPosts[currentIndex + 1] : null;

// Schema.org JSON-LD
const canonicalUrl = new URL(currentPath + '/', Astro.site || Astro.url).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": frontmatter.title,
  "description": frontmatter.description || '',
  "datePublished": isoDate,
  "inLanguage": lang === 'fr' ? 'fr-CA' : 'en',
  "url": canonicalUrl,
  "author": {
    "@type": "Organization",
    "name": "Wahooka — Protocol 42",
    "url": "https://bouletstrategies.ca"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Boulet Stratégies TI",
    "url": "https://bouletstrategies.ca"
  },
  "image": new URL('/images/wahooka-avatar.png', Astro.site || Astro.url).href,
  "wordCount": wordCount,
  "keywords": (frontmatter.tags || []).join(', '),
};
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="post-nav-top">
    <a href={backHref} class="back-link">{backLabel}</a>
    {mirrorUrl && (
      <a href={mirrorUrl} class="lang-mirror-link">
        {mirrorLang === 'fr' ? '⚜️ Lire en français' : '🍁 Read in English'}
      </a>
    )}
  </div>
  <article>
    <header class="post-header">
      <h1>{frontmatter.title}</h1>
      <div class="post-meta">{date} · {(frontmatter.lang || 'en').toUpperCase()} · {readLabel}</div>
    </header>
    <div class="prose">
      <slot />
    </div>

    {mirrorUrl && (
      <div class="post-mirror-bottom">
        <a href={mirrorUrl}>
          {mirrorLang === 'fr' ? '⚜️ Lire cet article en français' : '🍁 Read this post in English'}
        </a>
      </div>
    )}

    <nav class="post-prev-next">
      {prevPost ? (
        <a href={prevPost.url} class="prev-next-link prev-link">
          <span class="prev-next-label">{lang === 'fr' ? '← Précédent' : '← Previous'}</span>
          <span class="prev-next-title">{prevPost.frontmatter.title}</span>
        </a>
      ) : <span />}
      {nextPost ? (
        <a href={nextPost.url} class="prev-next-link next-link">
          <span class="prev-next-label">{lang === 'fr' ? 'Suivant →' : 'Next →'}</span>
          <span class="prev-next-title">{nextPost.frontmatter.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>
