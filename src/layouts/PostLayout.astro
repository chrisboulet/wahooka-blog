---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    lang?: string;
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;
const lang = frontmatter.lang || 'en';
const date = new Date(frontmatter.date).toLocaleDateString(lang === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric', month: 'short', day: 'numeric'
});
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} lang={lang}>
  <a href="/blog" class="back-link">← back to posts</a>
  <article>
    <header class="post-header">
      <h1>{frontmatter.title}</h1>
      <div class="post-meta">{date} · {frontmatter.lang?.toUpperCase() || 'EN'}</div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
